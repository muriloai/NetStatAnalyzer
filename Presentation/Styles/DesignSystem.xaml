<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Calm slate surfaces with restrained semantic accents. -->
    <SolidColorBrush x:Key="BgPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="BgSecondary" Color="#242424" />
    <SolidColorBrush x:Key="BgTertiary" Color="#323232" />
    <SolidColorBrush x:Key="BgCard" Color="#292929" />
    <SolidColorBrush x:Key="SurfaceInset" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#282828" />
    <SolidColorBrush x:Key="BorderBrush" Color="#464646" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F1F1F1" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C5C5C5" />
    <SolidColorBrush x:Key="TextMuted" Color="#999999" />
    <SolidColorBrush x:Key="AccentColor" Color="#9A9A9A" />
    <SolidColorBrush x:Key="AccentHover" Color="#B2B2B2" />
    <SolidColorBrush x:Key="AccentHoverText" Color="#1B1B1B" />
    <SolidColorBrush x:Key="AccentPressed" Color="#787878" />
    <SolidColorBrush x:Key="PrimaryButtonColor" Color="#565656" />
    <SolidColorBrush x:Key="PrimaryButtonHover" Color="#6B6B6B" />
    <SolidColorBrush x:Key="PrimaryButtonPressed" Color="#414141" />
    <SolidColorBrush x:Key="PrimaryButtonTextColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBorder" Color="#D0D0D0" />
    <SolidColorBrush x:Key="AccentSurface" Color="#333333" />
    <SolidColorBrush x:Key="SuccessColor" Color="#83C9A6" />
    <SolidColorBrush x:Key="SuccessSurface" Color="#1F4036" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#4C9E78" />
    <SolidColorBrush x:Key="SuccessHoverBackground" Color="#25523F" />
    <SolidColorBrush x:Key="SuccessHoverText" Color="#F1F1F1" />
    <SolidColorBrush x:Key="WarningColor" Color="#FB923C" />
    <SolidColorBrush x:Key="WarningSurface" Color="#2A180E" />
    <SolidColorBrush x:Key="WarningBorder" Color="#EA580C" />
    <SolidColorBrush x:Key="DangerColor" Color="#D98A8A" />
    <SolidColorBrush x:Key="DangerSurface" Color="#432727" />
    <SolidColorBrush x:Key="DangerBorder" Color="#AB6262" />
    <SolidColorBrush x:Key="DangerHoverBackground" Color="#5A2E2E" />
    <SolidColorBrush x:Key="DangerHoverText" Color="#F1F1F1" />
    <SolidColorBrush x:Key="DataGridSurface" Color="#202020" />
    <SolidColorBrush x:Key="DataGridAlternateSurface" Color="#292929" />
    <SolidColorBrush x:Key="DataGridHeaderSurface" Color="#303030" />
    <SolidColorBrush x:Key="DataGridHoverSurface" Color="#363636" />
    <SolidColorBrush x:Key="DataGridSelectionSurface" Color="#484848" />
    <SolidColorBrush x:Key="DataGridSelectionText" Color="#F1F1F1" />
    <SolidColorBrush x:Key="DataGridSelectionBorder" Color="#BEBEBE" />
    <SolidColorBrush x:Key="DataGridGridline" Color="#3A3A3A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#484848" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3C3C3C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5F7FA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F5F7FA" />
    <!-- Global Modern Dark ToolTip Style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="TrustBadgeTemplate">
        <Border x:Name="TrustBadgeBorder"
                Background="{DynamicResource BgTertiary}"
                CornerRadius="4"
                Padding="6,2"
                HorizontalAlignment="Left"
                ToolTip="{Binding AllowBadgeToolTip}">
            <TextBlock x:Name="TrustBadgeText"
                       Text="{Binding AllowBadgeText}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondary}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                <Setter TargetName="TrustBadgeBorder" Property="Background" Value="{DynamicResource SuccessSurface}" />
                <Setter TargetName="TrustBadgeText" Property="Foreground" Value="{DynamicResource SuccessColor}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="AnnotationTrustBadgeTemplate">
        <Border x:Name="AnnotationTrustBorder"
                Background="{DynamicResource BgTertiary}"
                CornerRadius="4"
                Padding="6,2"
                HorizontalAlignment="Left">
            <TextBlock x:Name="AnnotationTrustText"
                       Text="{Binding AnnotationTrustText}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondary}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding AnnotationTrusted}" Value="True">
                <Setter TargetName="AnnotationTrustBorder" Property="Background" Value="{DynamicResource SuccessSurface}" />
                <Setter TargetName="AnnotationTrustText" Property="Foreground" Value="{DynamicResource SuccessColor}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="IntegrityBadgeTemplate">
        <Border Background="{Binding ThreatBadgeBackground}"
                CornerRadius="4"
                Padding="6,2"
                HorizontalAlignment="Left"
                ToolTip="{Binding ThreatBadgeToolTip}"
                Visibility="{Binding ThreatBadgeVisibility}">
            <TextBlock Text="{Binding ThreatBadgeText}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{Binding ThreatBadgeForeground}" />
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="IntegrityBadgeWithReasonTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ContentPresenter Content="{Binding}"
                              ContentTemplate="{StaticResource IntegrityBadgeTemplate}"
                              Margin="0,0,8,0" />
            <TextBlock Text="{Binding ThreatReason}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center"
                       Visibility="{Binding ThreatReasonVisibility}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>
    <!-- Primary Button -->
    <Style x:Key="ModernPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonColor}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextColor}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BgTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Reload Button - Processing Active State (Green) -->
    <Style x:Key="ModernReloadProcessingButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SuccessSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Wait" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SuccessSurface}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Secondary Button -->
    <Style x:Key="ModernSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="secBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="secBorder" Property="Background" Value="{DynamicResource BgCard}" />
                            <Setter TargetName="secBorder" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="secBorder" Property="Background" Value="{DynamicResource BgSecondary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="secBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="secBorder" Property="Background" Value="{DynamicResource BgPrimary}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern ToggleButton (for Live Reading) -->
    <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="tbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tbBorder" Property="Background" Value="{DynamicResource SuccessSurface}" />
                            <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="tbBorder" Property="Background" Value="{DynamicResource SurfaceInset}" />
                            <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                            <Setter Property="Opacity" Value="0.58" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern Dark ScrollBar Style -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BgTertiary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="false" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="false" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="thumbBorder" Background="{DynamicResource BorderBrush}" CornerRadius="4" Margin="1,0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource BorderLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="true">
                                                    <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource TextMuted}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="false" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="false" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border x:Name="thumbBorder" Background="{DynamicResource BorderBrush}" CornerRadius="4" Margin="0,1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource BorderLightBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="true">
                                                            <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource TextMuted}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Modern Inactive Tab Button -->
    <Style x:Key="ModernTabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BgTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern Active Tab Button (Connected & Embracing) -->
    <Style x:Key="ModernActiveTabButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBorder}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="activeTabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- Top Accent Highlight Bar -->
                            <Border Height="2" Background="{DynamicResource AccentColor}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="-10,-10,-10,0" CornerRadius="2,2,0,0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Permission Button -->
    <Style x:Key="ModernPermissionButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SuccessSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="wlBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="wlBorder" Property="Background" Value="{DynamicResource SuccessHoverBackground}" />
                            <Setter TargetName="wlBorder" Property="BorderBrush" Value="{DynamicResource SuccessHoverBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource SuccessHoverText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="wlBorder" Property="Background" Value="{DynamicResource SuccessSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Row Icon Button -->
    <Style x:Key="RowIconButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AccentHover}" />
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentHoverText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Modern TextBox -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBorder}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="tbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="tbBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ComboBox Styles -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BgTertiary}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource DataGridSelectionSurface}" />
                            <Setter Property="Foreground" Value="{DynamicResource DataGridSelectionText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Path x:Name="arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TextSecondary}" Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgTertiary}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource TextPrimary}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceInset}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButtonTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{x:Null}"
                                 Visibility="Collapsed"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource AccentBorder}"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="10,0,28,0"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center" />
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- DataGrid Styles -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridGridline}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="Background" Value="{DynamicResource DataGridSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource DataGridHeaderSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridline}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGridHoverSurface}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource DataGridSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinHeight" Value="38" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource DataGridAlternateSurface}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGridHoverSurface}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource DataGridSelectionSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DataGridSelectionBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource DataGridSelectionText}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource DataGridSelectionText}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModernDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DangerSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="dangBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dangBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}" />
                            <Setter TargetName="dangBorder" Property="BorderBrush" Value="{DynamicResource DangerHoverBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerHoverText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="dangBorder" Property="Background" Value="{DynamicResource DangerSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RowIconDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}" />
                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource DangerHoverBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource DangerHoverText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource DangerSurface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BgSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
