<Window x:Class="NetStatAnalyzer.AllowlistManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetStatAnalyzer"
        mc:Ignorable="d"
        Icon="pack://application:,,,/assets/icon.ico"
        Title="Gerenciador de Conexões Confiáveis - NetStatAnalyzer" 
        Height="540" Width="850"
        MinHeight="450" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Conexões Confiáveis" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <Border Background="{DynamicResource SuccessSurface}" BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="RuleCountTextBlock" Text="0 Conexões Confiáveis" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Conexões que correspondem à combinação de Processo + IP são reconhecidas e marcadas como confiáveis." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgTertiary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" 
                         Style="{StaticResource ModernTextBox}" 
                         Height="34" 
                         TextChanged="SearchTextBox_TextChanged"
                         VerticalAlignment="Center" />
                <TextBlock Text="Filtrar conexões por processo ou IP..." 
                           IsHitTestVisible="False" 
                           Foreground="{DynamicResource TextMuted}"
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="12,0,0,0"
                           Visibility="{Binding ElementName=SearchTextBox, Path=Text.IsEmpty, Converter={x:Static local:EmptyStringToVisibilityConverter.Instance}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Limpar Filtro" Style="{StaticResource ModernSecondaryButton}" Height="34" Click="ClearFilter_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgSecondary}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <DataGrid x:Name="RulesDataGrid" 
                      CanUserResizeColumns="True" 
                      CanUserReorderColumns="True" 
                      CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="PROCESSO" SortMemberPath="ProcessName" Width="160" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="PROTOCOLO" SortMemberPath="Protocol" Width="95" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSecondary}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,0">
                                    <TextBlock Text="{Binding Protocol}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBorder}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ENDEREÇO LOCAL" SortMemberPath="LocalAddress" Width="180" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LocalAddress}" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ENDEREÇO REMOTO" SortMemberPath="ForeignAddress" Width="180" MinWidth="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ForeignAddress}" FontFamily="Cascadia Code, Consolas, monospace" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ADICIONADO EM" SortMemberPath="AddedAt" Width="135" MinWidth="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddedAt, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="AÇÕES" CanUserSort="False" Width="95" MinWidth="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowIconDangerButton}" 
                                        Content="Remover" 
                                        ToolTip="Remover esta conexão da lista de confiáveis" 
                                        Click="DeleteRule_Click" 
                                        HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Importar JSON" 
                        Style="{StaticResource ModernSecondaryButton}" 
                        Height="34" Margin="0,0,8,0"
                        Click="ImportJson_Click" />
                <Button Content="Exportar JSON" 
                        Style="{StaticResource ModernSecondaryButton}" 
                        Height="34" Margin="0,0,8,0"
                        Click="ExportJson_Click" />
                <Button Content="Limpar Tudo" 
                        Style="{StaticResource ModernDangerButton}" 
                        Height="34" 
                        Click="ClearAll_Click" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="Fechar" 
                    Style="{StaticResource ModernPrimaryButton}" 
                    Height="34" Width="90"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
