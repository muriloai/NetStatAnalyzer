<Window x:Class="NetStatAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetStatAnalyzer"
        mc:Ignorable="d"
        Icon="pack://application:,,,/NetStatAnalyzer;component/assets/icon.ico"
        Title="NetStatAnalyzer - Monitor de Rede, Processos, Recursos e Persistência" 
        Height="800" Width="1260"
        MinHeight="600" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#0E121A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Arial, sans-serif"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Primary Button -->
        <Style x:Key="ModernPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D3344" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="ModernSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C2230" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2E384C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="secBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#293347" />
                                <Setter TargetName="secBorder" Property="BorderBrush" Value="#4B556E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="secBorder" Property="Background" Value="#161B26" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="secBorder" Property="Background" Value="#121620" />
                                <Setter Property="Foreground" Value="#4B556E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ToggleButton (for Live Reading) -->
        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1C2230" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#2E384C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="tbBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tbBorder" Property="Background" Value="#065F46" />
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="Foreground" Value="#6EE7B7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="false" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="false" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBorder" Background="#334155" CornerRadius="4" Margin="1,0" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#475569" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#64748B" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                    <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsMouseOver}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="false" Opacity="0" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="false" Opacity="0" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="thumbBorder" Background="#334155" CornerRadius="4" Margin="0,1" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="#475569" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="true">
                                                                <Setter TargetName="thumbBorder" Property="Background" Value="#64748B" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Inactive Tab Button -->
        <Style x:Key="ModernTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1A202C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Active Tab Button (Connected & Embracing) -->
        <Style x:Key="ModernActiveTabButton" TargetType="Button">
            <Setter Property="Background" Value="#161B24" />
            <Setter Property="Foreground" Value="#60A5FA" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="BorderBrush" Value="#2B3548" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="activeTabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- Top Accent Highlight Bar -->
                                <Border Height="2" Background="#3B82F6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="-10,-10,-10,0" CornerRadius="2,2,0,0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Permission Button -->
        <Style x:Key="ModernPermissionButton" TargetType="Button">
            <Setter Property="Background" Value="#065F46" />
            <Setter Property="Foreground" Value="#ECFDF5" />
            <Setter Property="BorderBrush" Value="#059669" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="wlBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="wlBorder" Property="Background" Value="#047857" />
                                <Setter TargetName="wlBorder" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="wlBorder" Property="Background" Value="#064E3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row Icon Button -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2433" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#2E384C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2563EB" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60A5FA" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0E121A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#60A5FA" />
            <Setter Property="BorderBrush" Value="#283244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="tbBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="tbBorder" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Styles -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#151821" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2C3345" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" 
                          Grid.Column="1" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Fill="#CBD5E1" 
                          Data="M 0 0 L 4 4 L 8 0 Z" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#1E2330" />
                    <Setter TargetName="border" Property="BorderBrush" Value="#4B556E" />
                    <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0E121A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#283244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Background="#12151D"
                                        BorderBrush="#2E374A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0E121A" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#1E2535" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A202C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#131722" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinHeight" Value="38" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#171C28" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252E42" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#60A5FA" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Header & Windows Tools -->
            <RowDefinition Height="Auto" /> <!-- Row 1: Connected Tab Bar (Header Strip) -->
            <RowDefinition Height="*" />    <!-- Row 2: Active Tab Embracing Card Container -->
            <RowDefinition Height="Auto" /> <!-- Row 3: Scoped Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: CLEAN HEADER (Discreet version & Tools Dropdown) -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Discreet Version (Foto 3) -->
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NetStatAnalyzer" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionTextBlock" Text="v1.3.0" FontSize="11" FontWeight="Normal" Foreground="#64748B" Margin="8,2,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Auditoria de conexões de rede, processos ativos, consumo de banda e CPU, tarefas agendadas e inicialização" FontSize="12" Foreground="#8B949E" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Top Right Actions: Dropdown Tools & Single Global Refresh (No button repetition) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Windows Native Tools Dropdown Menu -->
                <Button x:Name="WindowsToolsBtn" 
                        Content="🛠️ Ferramentas do Windows ▾" 
                        Style="{StaticResource ModernSecondaryButton}" 
                        ToolTip="Menu rápido para abrir utilitários oficiais do sistema operacional Windows"
                        Click="WindowsToolsBtn_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="WindowsToolsMenu" Background="#161B24" BorderBrush="#2B3548" BorderThickness="1">
                            <MenuItem Header="📊 Monitor de Recursos" 
                                      ToolTip="Abrir o Monitor de Recursos do Windows (resmon.exe)" 
                                      Foreground="#F8FAFC" Click="OpenResourceMonitor_Click" />
                            <MenuItem Header="⏱️ Agendador de Tarefas" 
                                      ToolTip="Abrir o Agendador de Tarefas oficial do Windows (taskschd.msc)" 
                                      Foreground="#F8FAFC" Click="OpenTaskScheduler_Click" />
                            <MenuItem Header="⚙️ Aplicativos de Inicialização" 
                                      ToolTip="Abrir Configurações do Windows > Aplicativos de Inicialização (ms-settings:startupapps)" 
                                      Foreground="#F8FAFC" Click="OpenStartupSettings_Click" />
                            <MenuItem Header="📋 Gerenciador de Tarefas" 
                                      ToolTip="Abrir o Gerenciador de Tarefas do Windows (taskmgr.exe)" 
                                      Foreground="#F8FAFC" Click="OpenTaskManager_Click" />
                            <Separator Background="#2B3548" />
                            <MenuItem Header="📁 Pasta de Inicialização" 
                                      ToolTip="Abrir a pasta de inicialização do usuário (shell:startup)" 
                                      Foreground="#F8FAFC" Click="OpenStartupFolder_Click" />
                            <MenuItem Header="🔑 Editor do Registro" 
                                      ToolTip="Abrir o Editor do Registro do Windows (regedit.exe)" 
                                      Foreground="#F8FAFC" Click="OpenRegistryEditor_Click" />
                            <Separator Background="#2B3548" />
                            <MenuItem Header="🔄 Recarregar Todas as 4 Abas" 
                                      ToolTip="Executar nova leitura de conexões, processos, tarefas e inicialização" 
                                      Foreground="#60A5FA" Click="ReloadAll_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: TAB NAVIGATION STRIP (Directly attached to the container below) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,-1" Panel.ZIndex="10">
            <Button x:Name="TabConnectionsBtn" Content="🌐 Conexões de Rede" 
                    Style="{StaticResource ModernActiveTabButton}" 
                    Click="TabButton_Click" Tag="0" />

            <Button x:Name="TabProcessesBtn" Content="⚡ Processos &amp; Consumo" 
                    Style="{StaticResource ModernTabButton}" 
                    Click="TabButton_Click" Tag="1" />

            <Button x:Name="TabTasksBtn" Content="⏱️ Tarefas Agendadas" 
                    Style="{StaticResource ModernTabButton}" 
                    Click="TabButton_Click" Tag="2" />

            <Button x:Name="TabStartupBtn" Content="🚀 Itens de Inicialização" 
                    Style="{StaticResource ModernTabButton}" 
                    Click="TabButton_Click" Tag="3" />
        </StackPanel>

        <!-- ROW 2: ACTIVE TAB EMBRACING CARD CONTAINER (Foto 2: Delimiting frame that visually unites the active tab) -->
        <Border Grid.Row="2" Background="#161B24" BorderBrush="#2B3548" BorderThickness="1" CornerRadius="0,8,8,8" Padding="14">
            <Grid>

                <!-- ========================================== -->
                <!-- TAB 0: CONEXÕES DE REDE (COM MÉTRICAS PRÓPRIAS) -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentConnections" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Contextual Network Metric Cards -->
                        <RowDefinition Height="Auto" /> <!-- Filters Bar -->
                        <RowDefinition Height="*" />    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Contextual Metrics: Network Connections -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Total de conexões TCP e portas UDP monitoradas. Clique para redefinir filtros." MouseDown="MetricCardTotal_MouseDown">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL CONEXÕES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricTotalText" Text="{Binding MetricTotal}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0E2419" BorderBrush="#15803D" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Conexões ativas no estado ESTABLISHED. Clique para filtrar por este estado." MouseDown="MetricCardEstablished_MouseDown">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ESTABLISHED" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricEstablishedText" Text="{Binding MetricEstablished}" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#131F33" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Portas locais abertas em escuta (LISTENING). Clique para filtrar por este estado." MouseDown="MetricCardListening_MouseDown">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="LISTENING (EM ESCUTA)" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricListeningText" Text="{Binding MetricListening}" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#063E30" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0"
                                Cursor="Hand" ToolTip="Conexões autorizadas cadastradas na Lista de Confiáveis. Clique para filtrar." MouseDown="MetricCardAllowed_MouseDown">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CONFIÁVEIS (ALLOWLIST)" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricAllowedText" Text="{Binding MetricAllowed}" FontSize="18" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#2E1313" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12,8"
                                Cursor="Hand" ToolTip="Conexões com consumo elevado de recursos ou alertas heurísticos. Clique para filtrar." MouseDown="MetricCardThreat_MouseDown">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ALERTAS / ANOMALIAS" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricThreatText" Text="{Binding MetricThreatConnections}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filters Bar: Conexões -->
                    <Border Grid.Row="1" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Text="Buscar (Processo, IP, Porta, PID):" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <TextBox x:Name="SearchTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="32" 
                                         TextChanged="SearchTextBox_TextChanged" />
                            </StackPanel>

                            <!-- Protocol -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,6,0">
                                <TextBlock Text="Protocolo:" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="ProtocolComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="80" Height="32" 
                                          SelectionChanged="FilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todos" IsSelected="True" />
                                    <ComboBoxItem Content="TCP" />
                                    <ComboBoxItem Content="UDP" />
                                </ComboBox>
                            </StackPanel>

                            <!-- State -->
                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,6,0">
                                <TextBlock Text="Estado:" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="StateComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          ItemsSource="{Binding StateOptions}" 
                                          SelectedItem="{Binding SelectedState, Mode=TwoWay}" 
                                          Width="120" Height="32" 
                                          SelectionChanged="FilterComboBox_SelectionChanged" />
                            </StackPanel>

                            <!-- Trust Filter -->
                            <StackPanel Grid.Column="3" Orientation="Vertical" Margin="0,0,6,0">
                                <TextBlock Text="Confiança:" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="AllowFilterComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="135" Height="32" 
                                          SelectionChanged="FilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todas" IsSelected="True" />
                                    <ComboBoxItem Content="Apenas Confiáveis" />
                                    <ComboBoxItem Content="Não Cadastradas" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Live CPU Cutoff Filter -->
                            <StackPanel Grid.Column="4" Orientation="Vertical" Margin="0,0,6,0">
                                <TextBlock Text="Corte de CPU:" FontSize="11" FontWeight="Medium" Foreground="#FDE047" Margin="0,0,0,4" />
                                <ComboBox x:Name="CpuCutoffComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="105" Height="32" 
                                          SelectionChanged="CpuCutoffComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todos (0%)" IsSelected="True" Tag="0" />
                                    <ComboBoxItem Content="CPU &gt; 1%" Tag="1" />
                                    <ComboBoxItem Content="CPU &gt; 5%" Tag="5" />
                                    <ComboBoxItem Content="CPU &gt; 10%" Tag="10" />
                                    <ComboBoxItem Content="CPU &gt; 25%" Tag="25" />
                                    <ComboBoxItem Content="CPU &gt; 50%" Tag="50" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Only Anomalies Checkbox -->
                            <StackPanel Grid.Column="5" Orientation="Vertical" VerticalAlignment="Center" Margin="0,16,6,0">
                                <CheckBox x:Name="OnlyAnomaliesCheckBox" 
                                          Content="Apenas Alertas" 
                                          Foreground="#FCA5A5" 
                                          FontWeight="SemiBold" 
                                          FontSize="11" 
                                          Click="OnlyAnomaliesCheckBox_Click" />
                            </StackPanel>

                            <!-- Action Buttons: Clear, Export, Allowlist Manager, Reading Mode -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Limpar" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" Margin="0,0,4,0" 
                                        ToolTip="Redefinir filtros desta aba"
                                        Click="ClearFilters_Click" />
                                <Button Content="Exportar" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" Margin="0,0,4,0" 
                                        ToolTip="Exportar conexões em formato JSON, CSV ou TXT"
                                        Click="ExportConnections_Click" />
                                <Button Content="🛡️ Confiáveis" 
                                        Style="{StaticResource ModernPermissionButton}" 
                                        Height="32" Margin="0,0,6,0"
                                        ToolTip="Gerenciar regras de conexões confiáveis (Allowlist)"
                                        Click="OpenAllowManager_Click" />
                                <Border Background="#161B24" BorderBrush="#2B3548" BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ReloadButton" 
                                                Content="🔄 Atualizar" 
                                                Style="{StaticResource ModernPrimaryButton}" 
                                                Height="28" Padding="8,0"
                                                ToolTip="Executar leitura instantânea manual das conexões ativas"
                                                Click="Reload_Click" />
                                        <ToggleButton x:Name="ConnectionsLiveReadingToggleBtn" 
                                                      Content="⏱️ Leitura Contínua (2s)" 
                                                      Style="{StaticResource ModernToggleButtonStyle}" 
                                                      Height="28" Padding="8,0" Margin="2,0,0,0"
                                                      ToolTip="Iniciar leitura contínua automática de conexões a cada 2 segundos"
                                                      Click="ConnectionsLiveReadingToggleBtn_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Connections -->
                    <Border Grid.Row="2" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <ProgressBar x:Name="LoadingProgressBar" 
                                         VerticalAlignment="Top" 
                                         Height="3" 
                                         IsIndeterminate="True" 
                                         Background="#0E121A" 
                                         Foreground="#3B82F6" 
                                         BorderThickness="0" 
                                         Visibility="Collapsed" />

                            <DataGrid x:Name="DataGrid" 
                                      ItemsSource="{Binding FilteredEntries}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      CanUserDeleteRows="False" 
                                      CanUserResizeColumns="True" 
                                      CanUserReorderColumns="True" 
                                      CanUserSortColumns="True" 
                                      IsReadOnly="True" 
                                      SelectionMode="Extended" 
                                      SelectionUnit="FullRow" 
                                      AlternationCount="2" 
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="#1E2535" 
                                      HeadersVisibility="Column" 
                                      Background="#10141D" 
                                      Foreground="#FFFFFF" 
                                      BorderThickness="0" 
                                      SelectionChanged="DataGrid_SelectionChanged" 
                                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                                                <Setter Property="Background" Value="#0C251C" />
                                                <Setter Property="BorderBrush" Value="#10B981" />
                                                <Setter Property="BorderThickness" Value="3,1,0,1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="#161B24" BorderBrush="#2B3548" BorderThickness="1">
                                        <MenuItem Header="🛡️ Marcar Selecionado(s) como Confiável" Click="AddToAllowlist_Click" FontWeight="Bold" Foreground="#34D399" />
                                        <MenuItem Header="Remover das Conexões Confiáveis" Click="RemoveFromAllowlist_Click" Foreground="#F87171" />
                                        <Separator Background="#2B3548" />
                                        <MenuItem Header="📁 Abrir Local do Arquivo no Explorer" Click="OpenFileLocation_Click" FontWeight="Bold" Foreground="#FFFFFF" />
                                        <Separator Background="#2B3548" />
                                        <MenuItem Header="Copiar Detalhes da(s) Linha(s)" Click="CopyDetails_Click" Foreground="#F8FAFC" />
                                        <MenuItem Header="Copiar Endereço(s) Remoto(s)" Click="CopyForeignIP_Click" Foreground="#F8FAFC" />
                                        <MenuItem Header="Copiar Endereço(s) Local(is)" Click="CopyLocalIP_Click" Foreground="#F8FAFC" />
                                        <MenuItem Header="Copiar PID(s)" Click="CopyPID_Click" Foreground="#F8FAFC" />
                                        <Separator Background="#2B3548" />
                                        <MenuItem Header="Exportar Conexões Exibidas..." Click="ExportConnections_Click" Foreground="#60A5FA" FontWeight="SemiBold" />
                                        <MenuItem Header="🔄 Recarregar Conexões" Click="Reload_Click" Foreground="#F8FAFC" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <!-- PROCESSO -->
                                    <DataGridTemplateColumn Header="PROCESSO" SortMemberPath="ProcessName" Width="200" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="24" Height="24" CornerRadius="4" Background="#1C2333" Margin="0,0,8,0">
                                                        <Image Source="{Binding ProcessIcon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                                        <TextBlock Text="{Binding PID, StringFormat='PID: {0}'}" FontSize="10" Foreground="#94A3B8" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- CPU % -->
                                    <DataGridTemplateColumn Header="CPU (%)" SortMemberPath="CpuPercent" Width="85" MinWidth="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CpuBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding DisplayCpu}" FontSize="11" FontWeight="Bold" Foreground="{Binding CpuBadgeForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- BANDA / TAXA -->
                                    <DataGridTemplateColumn Header="BANDA" SortMemberPath="BandwidthBytesPerSec" Width="95" MinWidth="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayBandwidth}" 
                                                           FontFamily="Cascadia Code, Consolas, monospace" 
                                                           FontSize="11" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#93C5FD" 
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- STATUS CONFIANÇA -->
                                    <DataGridTemplateColumn Header="CONFIANÇA" SortMemberPath="IsAllowed" Width="110" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding AllowBadgeBackground}" 
                                                        BorderBrush="{Binding AllowBadgeBorder}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        HorizontalAlignment="Left" 
                                                        ToolTip="{Binding AllowBadgeToolTip}">
                                                    <TextBlock Text="{Binding AllowBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding AllowBadgeForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ALERTA / AMEAÇA -->
                                    <DataGridTemplateColumn Header="AMEAÇA" SortMemberPath="ThreatLevel" Width="140" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ThreatBadgeBackground}" 
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        HorizontalAlignment="Left" 
                                                        ToolTip="{Binding ThreatReason}" 
                                                        Visibility="{Binding ThreatBadgeVisibility}">
                                                    <TextBlock Text="{Binding ThreatBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ThreatBadgeForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- PROTOCOLO -->
                                    <DataGridTemplateColumn Header="PROTOCOLO" SortMemberPath="Protocol" Width="95" MinWidth="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ProtocolBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Protocol}" FontSize="11" FontWeight="Bold" Foreground="{Binding ProtocolBadgeForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- LOCAL -->
                                    <DataGridTemplateColumn Header="ENDEREÇO LOCAL" SortMemberPath="LocalAddress" Width="170" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LocalAddress}" 
                                                           FontFamily="Cascadia Code, Consolas, monospace" 
                                                           FontSize="11" 
                                                           Foreground="#FFFFFF" 
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- REMOTO -->
                                    <DataGridTemplateColumn Header="ENDEREÇO REMOTO" SortMemberPath="ForeignAddress" Width="170" MinWidth="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ForeignAddress}" 
                                                           FontFamily="Cascadia Code, Consolas, monospace" 
                                                           FontSize="11" 
                                                           Foreground="#FFFFFF" 
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ESTADO -->
                                    <DataGridTemplateColumn Header="ESTADO" SortMemberPath="State" Width="110" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StateBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="{Binding StateBadgeForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 1: PROCESSOS & CONSUMO (COM MÉTRICAS PRÓPRIAS) -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentProcesses" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Contextual Process Metric Cards -->
                        <RowDefinition Height="Auto" /> <!-- Action & Filters Bar -->
                        <RowDefinition Height="*" />    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Contextual Metrics: Processes -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PROCESSOS ATIVOS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricProcessesTotalText" Text="{Binding MetricProcessesTotal}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#291D10" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CPU &gt; 5%" FontSize="10" FontWeight="Bold" Foreground="#FDE047" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricProcessesHighCpuText" Text="{Binding MetricProcessesHighCpu}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#102330" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ALTO TRÁFEGO REDE" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricProcessesHighNetworkText" Text="{Binding MetricProcessesHighNetwork}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#18182E" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="BANDA COMBINADA" FontSize="10" FontWeight="Bold" Foreground="#C7D2FE" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricProcessesBandwidthSumText" Text="{Binding MetricProcessesBandwidthSum}" FontSize="18" FontWeight="Bold" Foreground="#818CF8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#2E1313" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DIAGNÓSTICOS / ALERTAS" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricProcessesThreatsText" Text="{Binding MetricProcessesThreats}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Action & Filters Bar: Processos (Live sampling, bandwidth cutoffs, open location) -->
                    <Border Grid.Row="1" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Text="Buscar Processo (Nome, PID ou Diagnóstico):" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <TextBox x:Name="ProcessSearchTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="32" 
                                         TextChanged="ProcessSearchTextBox_TextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Text="Corte de CPU:" FontSize="11" FontWeight="Medium" Foreground="#FDE047" Margin="0,0,0,4" />
                                <ComboBox x:Name="ProcessCpuCutoffComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="110" Height="32" 
                                          SelectionChanged="ProcessCpuCutoffComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todos (0%)" IsSelected="True" Tag="0" />
                                    <ComboBoxItem Content="CPU &gt; 1%" Tag="1" />
                                    <ComboBoxItem Content="CPU &gt; 5%" Tag="5" />
                                    <ComboBoxItem Content="CPU &gt; 10%" Tag="10" />
                                    <ComboBoxItem Content="CPU &gt; 25%" Tag="25" />
                                    <ComboBoxItem Content="CPU &gt; 50%" Tag="50" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0">
                                <TextBlock Text="Corte de Banda:" FontSize="11" FontWeight="Medium" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <ComboBox x:Name="ProcessBandwidthCutoffComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="125" Height="32" 
                                          SelectionChanged="ProcessBandwidthCutoffComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todas as Taxas" IsSelected="True" Tag="0" />
                                    <ComboBoxItem Content="&gt; 10 KB/s" Tag="10240" />
                                    <ComboBoxItem Content="&gt; 100 KB/s" Tag="102400" />
                                    <ComboBoxItem Content="&gt; 1 MB/s" Tag="1048576" />
                                    <ComboBoxItem Content="&gt; 10 MB/s" Tag="10485760" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center" Margin="0,16,8,0">
                                <CheckBox x:Name="ProcessOnlyAnomaliesCheckBox" 
                                          Content="Apenas Alertas" 
                                          Foreground="#FCA5A5" 
                                          FontWeight="SemiBold" 
                                          FontSize="11" 
                                          Click="ProcessOnlyAnomaliesCheckBox_Click" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Limpar" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" Margin="0,0,8,0"
                                        ToolTip="Redefinir filtros de processos"
                                        Click="ClearProcessFilters_Click" />
                                <Border Background="#161B24" BorderBrush="#2B3548" BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ProcessesReloadButton"
                                                Content="🔄 Atualizar" 
                                                Style="{StaticResource ModernPrimaryButton}" 
                                                Height="28" Padding="8,0"
                                                ToolTip="Capturar nova amostra manual instantânea dos processos"
                                                Click="RefreshProcesses_Click" />
                                        <ToggleButton x:Name="LiveReadingToggleBtn" 
                                                      Content="⏱️ Leitura Contínua (2s)" 
                                                      Style="{StaticResource ModernToggleButtonStyle}" 
                                                      Height="28" Padding="8,0" Margin="2,0,0,0"
                                                      ToolTip="Iniciar leitura contínua automática de CPU e Banda a cada 2 segundos"
                                                      Click="LiveReadingToggleBtn_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Aggregated Processes -->
                    <Border Grid.Row="2" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="ProcessesDataGrid" 
                                  ItemsSource="{Binding FilteredProcesses}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  CanUserResizeColumns="True" 
                                  CanUserSortColumns="True" 
                                  IsReadOnly="True" 
                                  AlternationCount="2" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#1E2535" 
                                  HeadersVisibility="Column" 
                                  Background="#10141D" 
                                  Foreground="#FFFFFF" 
                                  BorderThickness="0"
                                  MouseDoubleClick="ProcessesDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#161B24" BorderBrush="#2B3548" BorderThickness="1">
                                    <MenuItem Header="📁 Abrir Local do Arquivo no Explorer" Click="ProcessOpenFileLocation_Click" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <Separator Background="#2B3548" />
                                    <MenuItem Header="Copiar Detalhes do Processo" Click="CopyProcessDetails_Click" Foreground="#F8FAFC" />
                                    <MenuItem Header="Copiar PID" Click="CopyProcessPID_Click" Foreground="#F8FAFC" />
                                    <Separator Background="#2B3548" />
                                    <MenuItem Header="🔄 Recarregar Processos" Click="RefreshProcesses_Click" Foreground="#F8FAFC" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- PROCESSO -->
                                <DataGridTemplateColumn Header="PROCESSO" SortMemberPath="ProcessName" Width="220" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="4" Background="#1C2333" Margin="0,0,8,0">
                                                    <Image Source="{Binding ProcessIcon}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" />
                                                    <TextBlock Text="{Binding PID, StringFormat='PID: {0}'}" FontSize="10" Foreground="#94A3B8" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CPU % -->
                                <DataGridTemplateColumn Header="USO CPU" SortMemberPath="CpuPercent" Width="95" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CpuBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding FormattedCpu}" FontSize="11" FontWeight="Bold" Foreground="{Binding CpuBadgeForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- LEITURA / DOWNLOAD -->
                                <DataGridTextColumn Header="DOWNLOAD / LEITURA" Binding="{Binding FormattedReadBandwidth}" Width="150" MinWidth="120" />

                                <!-- ESCRITA / UPLOAD -->
                                <DataGridTextColumn Header="UPLOAD / ESCRITA" Binding="{Binding FormattedWriteBandwidth}" Width="150" MinWidth="120" />

                                <!-- BANDA TOTAL -->
                                <DataGridTemplateColumn Header="BANDA TOTAL" SortMemberPath="TotalBytesPerSec" Width="130" MinWidth="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedTotalBandwidth}" 
                                                       FontFamily="Cascadia Code, Consolas, monospace" 
                                                       FontWeight="Bold" 
                                                       Foreground="#38BDF8" 
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CONEXÕES ATIVAS -->
                                <DataGridTextColumn Header="CONEXÕES" Binding="{Binding ActiveConnectionsCount}" Width="95" MinWidth="80" />

                                <!-- DIAGNÓSTICO / AMEAÇA -->
                                <DataGridTemplateColumn Header="SEGURANÇA" SortMemberPath="ThreatLevel" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding ThreatBadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ThreatBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ThreatBadgeForeground}" />
                                                </Border>
                                                <TextBlock Text="{Binding ThreatReason}" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center" Visibility="{Binding ThreatReasonVisibility}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 2: TAREFAS AGENDADAS (COM MÉTRICAS PRÓPRIAS) -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentTasks" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Contextual Tasks Metric Cards -->
                        <RowDefinition Height="Auto" /> <!-- Action & Filter Bar -->
                        <RowDefinition Height="*" />    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Contextual Metrics: Scheduled Tasks -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL TAREFAS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricTasksTotalText" Text="{Binding MetricTasksTotal}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#0E2419" BorderBrush="#15803D" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="HABILITADAS" FontSize="10" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricTasksEnabledText" Text="{Binding MetricTasksEnabled}" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#161B26" BorderBrush="#2B3548" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DESABILITADAS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricTasksDisabledText" Text="{Binding MetricTasksDisabled}" FontSize="18" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#291D10" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="NÃO-MICROSOFT" FontSize="10" FontWeight="Bold" Foreground="#FDE047" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricTasksNonMicrosoftText" Text="{Binding MetricTasksNonMicrosoft}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#2E1313" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SUSPEITAS / ALERTA" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricTasksSuspiciousText" Text="{Binding MetricTasksSuspicious}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Action & Filter Bar: Tarefas Agendadas -->
                    <Border Grid.Row="1" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                                <TextBlock Text="Buscar Tarefa (Nome, Pasta, Ação ou Autor):" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <TextBox x:Name="TaskSearchTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="32" 
                                         TextChanged="TaskSearchTextBox_TextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,10,0">
                                <TextBlock Text="Filtrar Categoria:" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="TaskFilterComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="220" Height="32" 
                                          SelectionChanged="TaskFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todas as Tarefas" IsSelected="True" />
                                    <ComboBoxItem Content="Apenas Suspeitas / Não-Microsoft" />
                                    <ComboBoxItem Content="Apenas Habilitadas" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Limpar" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" Margin="0,0,6,0"
                                        ToolTip="Redefinir busca e filtros de tarefas agendadas"
                                        Click="ClearTaskFilters_Click" />
                                <Button Content="🔄 Atualizar" 
                                        Style="{StaticResource ModernPrimaryButton}" 
                                        Height="32" Margin="0,0,6,0"
                                        ToolTip="Recarregar a lista de tarefas agendadas do Windows" 
                                        Click="RefreshTasks_Click" />
                                <Button Content="⚙️ Agendador de Tarefas do Windows" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" 
                                        ToolTip="Abrir o utilitário oficial do Agendador de Tarefas do Windows (taskschd.msc)" 
                                        Click="OpenTaskScheduler_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Scheduled Tasks -->
                    <Border Grid.Row="2" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="TasksDataGrid" 
                                  ItemsSource="{Binding FilteredTasks}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  CanUserResizeColumns="True" 
                                  CanUserSortColumns="True" 
                                  IsReadOnly="True" 
                                  AlternationCount="2" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#1E2535" 
                                  HeadersVisibility="Column" 
                                  Background="#10141D" 
                                  Foreground="#FFFFFF" 
                                  BorderThickness="0"
                                  MouseDoubleClick="TasksDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#161B24" BorderBrush="#2B3548" BorderThickness="1">
                                    <MenuItem Header="📁 Abrir Local do Arquivo no Explorer" Click="TaskOpenFileLocation_Click" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <Separator Background="#2B3548" />
                                    <MenuItem Header="Copiar Detalhes da Tarefa" Click="CopyTaskDetails_Click" Foreground="#F8FAFC" />
                                    <MenuItem Header="Copiar Ação / Comando" Click="CopyTaskCommand_Click" Foreground="#F8FAFC" />
                                    <Separator Background="#2B3548" />
                                    <MenuItem Header="🔄 Recarregar Tarefas" Click="RefreshTasks_Click" Foreground="#F8FAFC" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- INTEGRIDADE -->
                                <DataGridTemplateColumn Header="INTEGRIDADE" SortMemberPath="ThreatLevel" Width="120" MinWidth="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ThreatBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding ThreatBadgeToolTip}">
                                                <TextBlock Text="{Binding ThreatBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ThreatBadgeForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- NOME DA TAREFA -->
                                <DataGridTextColumn Header="NOME DA TAREFA" Binding="{Binding TaskName}" FontWeight="Bold" Width="200" MinWidth="150" />

                                <!-- CAMINHO / PASTA -->
                                <DataGridTextColumn Header="PASTA" Binding="{Binding TaskPath}" Width="160" MinWidth="120" />

                                <!-- STATUS -->
                                <DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="95" MinWidth="80" />

                                <!-- COMANDO A EXECUTAR -->
                                <DataGridTemplateColumn Header="AÇÃO / COMANDO EXECUTADO" SortMemberPath="TaskToRun" Width="*" MinWidth="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TaskToRun}" 
                                                           FontFamily="Cascadia Code, Consolas, monospace" 
                                                           FontSize="11" 
                                                           Foreground="#F8FAFC" 
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ThreatReason}" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#FCA5A5" 
                                                           Visibility="{Binding ThreatReasonVisibility}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- AUTOR -->
                                <DataGridTextColumn Header="AUTOR" Binding="{Binding Author}" Width="150" MinWidth="100" />

                                <!-- PRÓXIMA EXECUÇÃO -->
                                <DataGridTextColumn Header="PRÓXIMA EXECUÇÃO" Binding="{Binding NextRunTime}" Width="140" MinWidth="110" />

                                <!-- ÚLTIMA EXECUÇÃO -->
                                <DataGridTextColumn Header="ÚLTIMA EXECUÇÃO" Binding="{Binding LastRunTime}" Width="140" MinWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- TAB 3: ITENS DE INICIALIZAÇÃO (COM MÉTRICAS PRÓPRIAS) -->
                <!-- ========================================== -->
                <Grid x:Name="TabContentStartup" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Contextual Startup Metric Cards -->
                        <RowDefinition Height="Auto" /> <!-- Action & Filter Bar -->
                        <RowDefinition Height="*" />    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Contextual Metrics: Startup Items -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="TOTAL INICIALIZAÇÃO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricStartupTotalText" Text="{Binding MetricStartupTotal}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#131F33" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="REGISTRO (RUN)" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricStartupRegistryText" Text="{Binding MetricStartupRegistry}" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#102330" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PASTA STARTUP" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricStartupFolderText" Text="{Binding MetricStartupFolder}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="#2E1313" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="SUSPEITOS / ALERTA" FontSize="10" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Center" />
                                <TextBlock x:Name="MetricStartupSuspiciousText" Text="{Binding MetricStartupSuspicious}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Action & Filter Bar: Itens de Inicialização -->
                    <Border Grid.Row="1" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                                <TextBlock Text="Buscar Aplicativo (Nome, Comando ou Localização):" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <TextBox x:Name="StartupSearchTextBox" 
                                         Style="{StaticResource ModernTextBox}" 
                                         Height="32" 
                                         TextChanged="StartupSearchTextBox_TextChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,10,0">
                                <TextBlock Text="Origem / Filtro:" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="StartupFilterComboBox" 
                                          Style="{StaticResource ModernComboBox}" 
                                          SelectedIndex="0" 
                                          Width="180" Height="32" 
                                          SelectionChanged="StartupFilterComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Todos os Itens" IsSelected="True" />
                                    <ComboBoxItem Content="Apenas Suspeitos" />
                                    <ComboBoxItem Content="Apenas Registro (Run)" />
                                    <ComboBoxItem Content="Apenas Pasta Inicializar" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Limpar" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" Margin="0,0,6,0"
                                        ToolTip="Redefinir busca e filtros de inicialização"
                                        Click="ClearStartupFilters_Click" />
                                <Button Content="🔄 Atualizar" 
                                        Style="{StaticResource ModernPrimaryButton}" 
                                        Height="32" Margin="0,0,6,0"
                                        ToolTip="Reexaminar chaves do Registro e pastas de inicialização do Windows" 
                                        Click="RefreshStartup_Click" />
                                <Button Content="⚙️ Aplicativos de Inicialização do Windows" 
                                        Style="{StaticResource ModernSecondaryButton}" 
                                        Height="32" 
                                        ToolTip="Abrir o painel oficial do Windows de Aplicativos de Inicialização (Configurações > Aplicativos > Inicialização)" 
                                        Click="OpenStartupSettings_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid Startup Items -->
                    <Border Grid.Row="2" Background="#10141D" BorderBrush="#202735" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <DataGrid x:Name="StartupDataGrid" 
                                  ItemsSource="{Binding FilteredStartupItems}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  CanUserResizeColumns="True" 
                                  CanUserSortColumns="True" 
                                  IsReadOnly="True" 
                                  AlternationCount="2" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="#1E2535" 
                                  HeadersVisibility="Column" 
                                  Background="#10141D" 
                                  Foreground="#FFFFFF" 
                                  BorderThickness="0"
                                  MouseDoubleClick="StartupDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#161B24" BorderBrush="#2B3548" BorderThickness="1">
                                    <MenuItem Header="📁 Abrir Local do Arquivo no Explorer" Click="StartupOpenFileLocation_Click" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <Separator Background="#2B3548" />
                                    <MenuItem Header="Copiar Detalhes do Item" Click="CopyStartupDetails_Click" Foreground="#F8FAFC" />
                                    <MenuItem Header="Copiar Comando / Chave" Click="CopyStartupCommand_Click" Foreground="#F8FAFC" />
                                    <Separator Background="#2B3548" />
                                    <MenuItem Header="🔄 Recarregar Inicialização" Click="RefreshStartup_Click" Foreground="#F8FAFC" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- INTEGRIDADE -->
                                <DataGridTemplateColumn Header="INTEGRIDADE" SortMemberPath="ThreatLevel" Width="120" MinWidth="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ThreatBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" ToolTip="{Binding ThreatBadgeToolTip}">
                                                <TextBlock Text="{Binding ThreatBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ThreatBadgeForeground}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- NOME -->
                                <DataGridTextColumn Header="NOME DO APLICATIVO" Binding="{Binding Name}" FontWeight="Bold" Width="200" MinWidth="150" />

                                <!-- LOCALIZAÇÃO -->
                                <DataGridTextColumn Header="LOCALIZAÇÃO" Binding="{Binding Location}" Width="190" MinWidth="140" />

                                <!-- TIPO -->
                                <DataGridTextColumn Header="TIPO" Binding="{Binding SourceType}" Width="110" MinWidth="90" />

                                <!-- COMANDO / CAMINHO -->
                                <DataGridTemplateColumn Header="COMANDO / CAMINHO DO EXECUTÁVEL" SortMemberPath="Command" Width="*" MinWidth="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Command}" 
                                                           FontFamily="Cascadia Code, Consolas, monospace" 
                                                           FontSize="11" 
                                                           Foreground="#F8FAFC" 
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ThreatReason}" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#FCA5A5" 
                                                           Visibility="{Binding ThreatReasonVisibility}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ROW 3: SCOPED BOTTOM STATUS BAR -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Contextual Status Text -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTextBlock" Text="Pronto" FontSize="12" Foreground="#CBD5E1" />
                <TextBlock Text=" • " FontSize="12" Foreground="#4B556E" Margin="6,0" />
                <TextBlock x:Name="ConnectionCountText" Text="{Binding CurrentTabSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                <TextBlock x:Name="SelectedSeparator" Text=" • " FontSize="12" Foreground="#4B556E" Margin="6,0" Visibility="Collapsed" />
                <TextBlock x:Name="SelectedProcessText" Text="" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" Visibility="Collapsed" />
            </StackPanel>

            <!-- Scoped Contextual Action (Only on Tab 0: Network Connections; no duplicate buttons) -->
            <StackPanel x:Name="ConnectionsActionPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Visible">
                <Button Content="Marcar Selecionado como Confiável" 
                        Style="{StaticResource ModernPermissionButton}" 
                        Height="28" 
                        ToolTip="Adicionar o(s) processo(s) selecionado(s) à lista de conexões confiáveis" 
                        Click="AddToAllowlist_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
